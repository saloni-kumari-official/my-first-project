# Copy this file to .env and fill only the integrations you want to enable.
PORT=3000
ADMIN_API_KEY=replace-with-a-long-random-secret
ARTIST_WHATSAPP=

# Instagram Graph API: account must meet Meta's API requirements.
INSTAGRAM_USERNAME=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=v25.0

# Razorpay: use test keys first. Keep the secret on the server only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

